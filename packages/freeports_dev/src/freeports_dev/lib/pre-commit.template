#!/bin/sh
#
# Pre-commit hook for freeports format repositories.
# Runs format tests before allowing a commit.
#

if [ "$(basename "${VIRTUAL_ENV:-}")" != "freeports-dev" ] && [ "${CONDA_DEFAULT_ENV:-}" != "freeports-dev" ]; then
    echo "You have to activate \`freeports-dev\` environment to commit" 1>&2
    echo "In order to do so, execute one of the following:" 1>&2
    echo "  - venv  →  source venv/freeports-dev/bin/activate" 1>&2
    echo "  - conda →  conda activate freeports-dev" 1>&2
    exit 1
fi

# The repository being committed, named outright rather than inherited.
#
# Everything below acts on *this* working tree, and git already knows which one it is. Left to
# resolve it themselves, `freeports-dev` and `freeports-validate` would each consult their own
# tiers -- `--repo`, then `FREEPORTS_FORMATS_REPO_PATH`, then `formats_repo` in whatever
# configuration file is found from here -- and any of those can name a different repository than the
# one you are committing to. A relative value carried in from another directory is the usual way it
# happens, and it fails confusingly: the path comes out doubled, and the hook says the repository is
# not a repository. A hook has no business asking where it is.
repo_root=$(git rev-parse --show-toplevel) || exit 1

freeports-dev test --repo "$repo_root" -- -m "not integration_tests"


# Keep the validation report current, and never refuse a commit over it.
#
# The badges, the block in README.md and the six pages under validation/report/ are all functions
# of this repository's validation documents, so a commit that changes a granted file and leaves
# them alone publishes figures that are already wrong. Regenerating them here, and `git add`ing
# what was rewritten, puts the refresh in the same commit as the change that caused it.
#
# Nothing below can fail the hook, on purpose. The figures depend on resolving each methodology
# page from wherever this machine is configured to fetch it, and a committer on a train, behind a
# proxy, or working in a repository whose documentation server is down still has to be able to
# commit. A report one run out of date is a smaller problem than a commit that cannot be made.
if command -v freeports-validate >/dev/null 2>&1; then
    report_model=$(mktemp "${TMPDIR:-/tmp}/freeports-report.XXXXXX" 2>/dev/null) || report_model=""

    if [ -n "$report_model" ] &&
        freeports-validate --repo "$repo_root" collect > "$report_model" 2>/dev/null; then
        # One walk of the repository, rendered nine times. Collecting once per artefact would
        # re-resolve every methodology page nine times for an answer that cannot have changed in
        # between.
        refresh() {
            freeports-validate --repo "$repo_root" report \
                --model "$report_model" "$@" >/dev/null 2>&1
        }

        # Only what was actually rewritten is staged. A page somebody deleted, or one whose marker
        # pair they removed, is left alone rather than recreated behind their back.
        refreshed=""
        if refresh --format badges --out "$repo_root/validation/report/badges/"; then
            refreshed="$refreshed validation/report/badges"
        fi
        if [ -f "$repo_root/README.md" ] && refresh --format markdown --out "$repo_root/README.md"; then
            refreshed="$refreshed README.md"
        fi
        for table in file-contributor file-methodology contributor-methodology \
                     contributor-file methodology-file methodology-contributor; do
            page="validation/report/$table.md"
            [ -f "$repo_root/$page" ] || continue
            if refresh --format markdown --table "$table" --out "$repo_root/$page"; then
                refreshed="$refreshed $page"
            fi
        done

        # Unquoted on purpose: the names are the fixed ones just above, none of which contains a
        # space, and this is the one place the list has to be split back into arguments.
        if [ -n "$refreshed" ]; then
            # Staged by path relative to the top level, which is what `git add --` wants and what
            # `refreshed` holds -- the absolute forms above are only for `--out`.
            git -C "$repo_root" add -- $refreshed
            echo "freeports-validate: report refreshed"
        fi
    else
        echo "freeports-validate: the grants could not be read, so the report is unchanged" 1>&2
    fi

    rm -f "$report_model"
fi


if git rev-parse --verify HEAD >/dev/null 2>&1
then
	against=HEAD
else
	against=$(git hash-object -t tree /dev/null)
fi

allownonascii=$(git config --type=bool hooks.allownonascii)

exec 1>&2

if [ "$allownonascii" != "true" ] &&
	test $(git diff-index --cached --name-only --diff-filter=A -z $against |
	  LC_ALL=C tr -d '[ -~]\0' | wc -c) != 0
then
	cat <<\EOF
Error: Attempt to add a non-ASCII file name.

This can cause problems if you want to work with people on other platforms.

To be portable it is advisable to rename the file.

If you know what you are doing you can disable this check using:

  git config hooks.allownonascii true
EOF
	exit 1
fi
