#!/bin/bash
# The GPG key that identifies you as the signer of the grants you issue.
#
# Only the subcommands that speak in your name need it -- create-document, grant, ungrant,
# update, sign-document. Verifying somebody else's work (check-grants on a document,
# who-grants, granted-by, granted-with) needs no key, so continuous integration can leave
# this unset.
#
# This is the environment tier. The same setting can be given as `--key-id` on the command line, or
# written once in the freeports configuration file:
#
#     validate:
#       key_id: <keyid>
export FREEPORTS_VALIDATE_KEY_ID="<keyid>"
