#!/bin/bash
# The GPG key that identifies you as the signer of the grants you issue.
#
# Only the subcommands that speak in your name need it -- create-document, grant, ungrant,
# update, sign-document. Verifying somebody else's work (check-grants on a document,
# who-grants, granted-by, granted-with) needs no key, so continuous integration can leave
# this unset.
#
# This is the environment tier. The same setting can be given as `--key-id` on the command line, or
# written once in the freeports configuration file:
#
#     validate:
#       key_id: <keyid>
export FREEPORTS_VALIDATE_KEY_ID="<keyid>"

# Where methodology pages are resolved from.
#
# The pages do not ship with the command. A grant is made under a *text*, and this says which text:
# a pattern containing exactly one `*`, which stands for the methodology's own name --
# `general_methodology`, or `methodologies/basic_check`. So
#
#     https://docs.freeports.org/en/stable/_sources/validation/*.rst.txt
#
# resolves `basic check` to
# `https://docs.freeports.org/en/stable/_sources/validation/methodologies/basic_check.rst.txt`.
# That pattern is also the default, and is what you get when no tier names anything.
#
# **This variable carries exactly one source, and its value is never split.** Comma, colon, space
# and semicolon are all legal characters in a URI and in a path, so there is no separator that could
# be picked without turning somebody's single source into two that do not exist. It is the same rule
# FREEPORTS_TARGET_LIST follows.
#
# For several sources -- the published documentation *plus* your own methodologies -- use the
# configuration file, whose tier takes a list, or repeat `--source` on the command line:
#
#     validate:
#       sources:
#         - https://docs.freeports.org/en/stable/_sources/validation/*.rst.txt
#         - ../my-methodologies/*.rst
#
# Order is priority: a name is resolved from the first source that offers it. The tiers do not
# merge -- the strongest one that names any source provides the whole list -- so setting this
# variable ignores the list in the configuration file entirely. `freeports-validate sources` prints
# what each configured source resolves, which is the answer to "why does my hash differ from yours".
export FREEPORTS_VALIDATE_SOURCE="https://docs.freeports.org/en/stable/_sources/validation/*.rst.txt"

# Never fetch a methodology page: answer from what has already been cached, and say so on the line
# where a check depended on it. A methodology with nothing cached is reported as *unreachable* --
# neither matching nor mismatched, because an unfetched page cannot be compared with anything.
#
# For a machine that is permanently without egress. `--offline` is the same setting for one run, and
# `validate.offline` in the configuration file is the same setting written down once.
# Unset, or 0/false/no/off, all mean the same thing: fetch.
export FREEPORTS_VALIDATE_OFFLINE="0"

# Whether to follow what a methodology page pins. ON unless something turns it off.
#
# A page may pin the links and images it cites, by hash, in `.. sha256:` comments. Those lines are
# part of the page, so the page's own hash already commits to them -- this is not a second thing to
# trust but a deepening: it asks whether the things the page cites still say what its author read.
# That is the question a reader is really asking, so it is what a check does by default rather than
# what they have to know to ask for.
#
# Understood by `check-methodology` and `check-grants`. It costs one fetch per pinned resource, so
# there is a way out: 0/false/no/off here, `validate.deep: false` in the configuration file, or
# `--no-deep` (`--shallow`) for one run. Turning it off is a decision about cost -- the page's own
# hash still matches, and that is what the document recorded.
#
# Note that `0` here is a *no*, not a silence: it beats a configuration file that says true.
export FREEPORTS_VALIDATE_DEEP="1"
