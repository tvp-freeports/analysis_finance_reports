#!/bin/bash
# The GPG key that identifies you as the signer of the grants you issue.
#
# This is the environment tier. The same setting can be given as `--key-id` on the command line, or
# written once in the freeports configuration file:
#
#     validate:
#       key_id: <keyid>
export FREEPORTS_VALIDATE_KEY_ID="<keyid>"
