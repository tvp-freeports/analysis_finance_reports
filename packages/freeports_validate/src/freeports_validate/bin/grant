#!/bin/bash

source "${FREEPORTS_VALIDATE_LIB}/utils"

require_key

METHODOLOGY=""
FILES=()

# Overrides the two refusals a methodology's `Supported paths` section can produce -- a path the
# methodology does not declare, and a page that could not be resolved at all. Both are judgements
# the person signing is entitled to make; what the flag cannot do is make them silently, since the
# refusal is printed either way.
FORCE=false

# Parse arguments
while [ $# -gt 0 ]; do
    case $1 in
        with)
            shift
            METHODOLOGY="$1"
            shift
            ;;
        --force)
            FORCE=true
            shift
            ;;
        *)
            FILES+=("$1")
            shift
            ;;
    esac
done

if [ -z "$METHODOLOGY" ]; then
    print_error "Usage: $0 [--force] <files...> [with <methodology>]"
    exit 1
fi

if [ -z "$PERSONAL_DOC" ]; then
    print_error "No validation document found for current user"
    echo "Run create-document first to create your validation document"
    exit 1
fi

# Validate document schema and signature before making changes
if ! validate_document_schema "$PERSONAL_DOC"; then
    print_error "Document schema is invalid - cannot proceed with grant operation"
    exit 1
fi

if ! validate_document_signature "$PERSONAL_DOC"; then
    print_error "Operation cancelled due to invalid signature"
    exit 1
fi

# If no files are provided, just add the methodology
METHODOLOGY=$(normalize_methodology_name "$METHODOLOGY")
if [ ${#FILES[@]} -eq 0 ]; then
    print_info "Adding methodology: $METHODOLOGY"
    
    # Check if methodology already exists
    if methodology_exists "$PERSONAL_DOC" "$METHODOLOGY"; then
        print_warning "Methodology '$METHODOLOGY' already exists in validation document"
        exit 0
    fi
    
    # The hash is of the text a *source* offers, not of a file this command carries. Adopting a
    # methodology is therefore a statement about a published document, and this is the moment the
    # granter commits to which publication of it they mean.
    resolution=$(resolve_methodology "$METHODOLOGY") || resolution_status=$?
    if [ -n "${resolution_status:-}" ]; then
        report_methodology_resolution "$resolution_status" "Methodology '$METHODOLOGY'" "true"
        print_diagnoses
        exit 1
    fi
    methodology_uri=$(echo "$resolution" | sed -n 1p)
    methodology_hash=$(sha256_of_file "$(echo "$resolution" | sed -n 2p)")
    print_info "Resolved from: $methodology_uri"

    
    # Add methodology to methodologies list
    add_methodology_to_document "$PERSONAL_DOC" "$METHODOLOGY" "$methodology_hash"

    print_success "Added methodology '$METHODOLOGY' with hash: $methodology_hash"
    echo "Updating signature..."
    "$BIN_DIR/sign-document" --update
    exit 0
fi

# Check if methodology exists in the document
if ! methodology_exists "$PERSONAL_DOC" "$METHODOLOGY"; then
    print_error "Methodology '$METHODOLOGY' not found in validation document"
    echo "Available methodologies:"
    yq -r '.methodologies[].name' "$PERSONAL_DOC"
    echo ""
    echo "To add this methodology, run: $0 with '$METHODOLOGY'"
    exit 1
fi

# Nothing is written until every file has passed.
#
# A grant is one act: the document is modified file by file and signed once at the end, so stopping
# halfway would leave a document that had been changed and not signed -- the state `check-grants`
# reports as "no signature found", reached by a command that was doing what it was told. Asking
# every question first costs one extra pass over a handful of paths.
for file in "${FILES[@]}"; do
    if [ ! -f "$file" ]; then
        print_error "File '$file' does not exist"
        exit 1
    fi
done

# One `realpath` for the whole list. It answers in the order it was asked, which is the order
# everything below indexes the two lists by.
mapfile -t RELATIVE_PATHS < <(realpath --relative-to="$REPO_ROOT" -- "${FILES[@]}")

# What the methodology says it covers, if it says anything at all. A page with no
# `Supported paths` section accepts whatever it is given, which is the behaviour from before
# the section existed.
#
# Asked about every path in one question, and then explained one path at a time: the explanation is
# a paragraph naming the file and printing every pattern with its prose, so it is worth printing
# for the handful of paths that earned it and unbearable for the hundreds that did not.
unsupported_paths "$METHODOLOGY" ${RELATIVE_PATHS[@]+"${RELATIVE_PATHS[@]}"}
scope_status=$?
if [ "$scope_status" -eq "$PATH_UNDECIDABLE" ]; then
    # The page could not be read at all. That is one fact about the methodology rather than one per
    # file, so it is put to the granter once, against the first path, and its answer settles them
    # all -- the alternative being the same question several hundred times.
    require_supported_path "$METHODOLOGY" "${RELATIVE_PATHS[0]}" "$FORCE" || exit 1
else
    for rel_path in ${UNSUPPORTED_PATHS[@]+"${UNSUPPORTED_PATHS[@]}"}; do
        require_supported_path "$METHODOLOGY" "$rel_path" "$FORCE" || exit 1
    done
fi

# Every hash in one `sha256sum`, which reads the files in the order it was given them. A grant is a
# statement about file contents, so this is the one part of the work that is genuinely proportional
# to what is being granted; what it must not also be is proportional in *processes*.
mapfile -t FILE_HASHES < <(sha256sum -- "${FILES[@]}" | awk '{print $1}')

# What the document already says, read once. Re-granting a file it already holds is not an error --
# a granter naming a whole directory should not have to remember which of it they did last week --
# so each one is reported and skipped.
declare -A ALREADY_GRANTED=()
while IFS= read -r granted_path; do
    [ -n "$granted_path" ] && ALREADY_GRANTED["$granted_path"]=1
done < <(granted_paths_under_methodology "$PERSONAL_DOC" "$METHODOLOGY")

new_paths=()
new_hashes=()
for index in "${!RELATIVE_PATHS[@]}"; do
    rel_path="${RELATIVE_PATHS[$index]}"

    if [ -n "${ALREADY_GRANTED[$rel_path]:-}" ]; then
        print_warning "File '$rel_path' is already granted with methodology '$METHODOLOGY'"
        continue
    fi

    new_paths+=("$rel_path")
    new_hashes+=("${FILE_HASHES[$index]}")
    print_success "Granted '$rel_path' with methodology '$METHODOLOGY'"
done

if [ "${#new_paths[@]}" -eq 0 ]; then
    print_info "Nothing to add: every file was already granted with methodology '$METHODOLOGY'"
    exit 0
fi

# The entries, built in one pass and handed over in a file.
#
# `jq -Rn` with `inputs` reads the paths as raw lines, so no character in a path needs escaping
# here and none is interpreted; the hashes are hexadecimal and go alongside by position. Doing this
# per file instead would be one `jq` and two `yq` per file over a document that grows as the loop
# runs, which is what made granting a test suite of several hundred files take minutes.
entries_file=$(mktemp "${TMPDIR:-/tmp}/freeports-grant.XXXXXX") || exit 1
hashes_file=$(mktemp "${TMPDIR:-/tmp}/freeports-grant.XXXXXX") || exit 1
trap 'rm -f "$entries_file" "$hashes_file"' EXIT

printf '%s\n' "${new_hashes[@]}" > "$hashes_file"
printf '%s\n' "${new_paths[@]}" | jq -Rn --rawfile hashes "$hashes_file" '
    [inputs] as $paths
    | ($hashes | rtrimstr("\n") | split("\n")) as $sha
    | [range(0; $paths | length) | {path: $paths[.], sha256: $sha[.]}]' > "$entries_file"

add_file_grants_to_document "$PERSONAL_DOC" "$METHODOLOGY" "$entries_file"

print_success "Grant operation completed. Document updated: $PERSONAL_DOC"
echo "Updating signature..."
"$BIN_DIR/sign-document" --update

