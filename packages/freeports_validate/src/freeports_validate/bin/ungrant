#!/bin/bash

source "${FREEPORTS_VALIDATE_LIB}/utils"

require_key

METHODOLOGY=""
FILES=()
ANY_METHODOLOGY=false

# Parse arguments
while [ $# -gt 0 ]; do
    case $1 in
        with)
            shift
            if [ "$1" = "any" ]; then
                ANY_METHODOLOGY=true
            else
                METHODOLOGY="$1"
            fi
            shift
            ;;
        *)
            FILES+=("$1")
            shift
            ;;
    esac
done

if [ -z "$PERSONAL_DOC" ]; then
    print_error "No validation document found for current user"
    echo "Run create-document first to create your validation document"
    exit 1
fi

# Validate document schema and signature before making changes
if ! validate_document_schema "$PERSONAL_DOC"; then
    print_error "Document schema is invalid - cannot proceed with ungrant operation"
    exit 1
fi

if ! validate_document_signature "$PERSONAL_DOC"; then
    print_error "Operation cancelled due to invalid signature"
    exit 1
fi

# Normalize methodology name if specified
if [ -n "$METHODOLOGY" ]; then
    METHODOLOGY=$(normalize_methodology_name "$METHODOLOGY")
fi

# Case 1: ungrant with <methodology> (no files) - remove all files with that methodology and the methodology itself
if [ ${#FILES[@]} -eq 0 ] && [ -n "$METHODOLOGY" ]; then
    print_warning "This will remove ALL files granted with methodology '$METHODOLOGY' and the methodology itself from the document."
    echo "This action cannot be undone."
    read -p "Are you sure you want to continue? (y/N): " confirm
    
    if [[ $confirm =~ ^[Yy]$ ]]; then
        # Remove all files with this methodology from data section
        yq -y -i "del(.data[] | select(.methodology == \"$METHODOLOGY\"))"  "$PERSONAL_DOC"
        
        # Remove the methodology from methodologies section
        yq -y -i "del(.methodologies[] | select(.name == \"$METHODOLOGY\"))"  "$PERSONAL_DOC"
        
        print_success "Removed all files and methodology '$METHODOLOGY' from validation document"
        echo "Updating signature..."
        "$BIN_DIR/sign-document" --update
        exit 0
    else
        print_info "Operation cancelled"
    fi
    exit 0
fi

# Cases 2 and 3: ungrant <files> with any | <methodology>
#
# The path is resolved, not looked up on disk: the usual order is to delete a file first and ungrant
# it afterwards, and `check-grants` says exactly that about a granted file that is gone. A path the
# document does not hold is warned about and skipped, so one wrong path in a list does not cost the
# right ones; the document is re-signed only if something was removed.
if [ ${#FILES[@]} -gt 0 ] && { [ "$ANY_METHODOLOGY" = true ] || [ -n "$METHODOLOGY" ]; }; then
    if [ "$ANY_METHODOLOGY" = false ] && ! methodology_exists "$PERSONAL_DOC" "$METHODOLOGY"; then
        print_error "Methodology '$METHODOLOGY' not found in validation document"
        exit 1
    fi

    # Every path is checked before the document is touched: a refusal leaves it as it was.
    mapfile -t RELATIVE_PATHS < <(realpath -m --relative-to="$REPO_ROOT" -- "${FILES[@]}")
    for index in "${!FILES[@]}"; do
        case "${RELATIVE_PATHS[$index]}" in
            ..|../*)
                print_error "File '${FILES[$index]}' is outside the repository ($REPO_ROOT)"
                exit 1
                ;;
        esac
    done

    if [ "$ANY_METHODOLOGY" = true ]; then
        scope="all methodologies"
        granted_query='[.data[].files[] | select(.path == $path)] | length'
        remove_query='del(.data[].files[] | select(.path == $path))'
    else
        scope="methodology '$METHODOLOGY'"
        granted_query='[.data[] | select(.methodology == $methodology).files[] | select(.path == $path)] | length'
        remove_query='del(.data[] | select(.methodology == $methodology).files[] | select(.path == $path))'
    fi

    removed=0
    for rel_path in "${RELATIVE_PATHS[@]}"; do
        granted=$(yq --arg path "$rel_path" --arg methodology "$METHODOLOGY" "$granted_query" "$PERSONAL_DOC")
        if [ "$granted" -eq 0 ]; then
            print_warning "'$rel_path' is not granted with $scope: nothing to remove"
            continue
        fi
        if [ ! -e "$REPO_ROOT/$rel_path" ]; then
            print_info "'$rel_path' no longer exists; removing its grant"
        fi

        yq -y -i --arg path "$rel_path" --arg methodology "$METHODOLOGY" "$remove_query" "$PERSONAL_DOC"
        # Clean up empty methodology sections
        yq -y -i 'del(.data[] | select(.files | length == 0))' "$PERSONAL_DOC"

        print_success "Removed '$rel_path' from $scope"
        removed=$((removed + 1))
    done

    if [ "$removed" -eq 0 ]; then
        print_error "Nothing was ungranted; the document is unchanged"
        exit 1
    fi

    print_success "Ungrant operation completed. Document updated: $PERSONAL_DOC"
    echo "Updating signature..."
    "$BIN_DIR/sign-document" --update
    exit 0
fi

# If we get here, the arguments are invalid
print_error "Usage:"
echo "  $0 with <methodology>                    - Remove all files with methodology and the methodology itself"
echo "  $0 <files...> with any                   - Remove files from all methodologies"
echo "  $0 <files...> with <methodology>         - Remove files from specific methodology"
exit 1


