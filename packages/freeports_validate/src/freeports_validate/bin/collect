#!/bin/bash

# The model: one walk of the repository's validation documents, as JSON on standard output.
#
# Everything the report shows is decided here, and nothing about how it looks is. That is not
# tidiness -- it is what makes `report --format json | jq ...` a first-class way to use this
# command rather than a debugging aid: a question none of the renderings anticipated is answerable
# from the same output they are drawn from, by a reader who never opens `lib/report.py`.
#
# It is bash for the same reason the rest of the command is: every fact in the model is established
# by a command a user can retype -- `sha256sum` on a granted file, `gpg --verify` on a document,
# `resolve_methodology` on a name -- and a model assembled by an interpreter nobody can watch would
# be a set of claims about the repository rather than a reading of it.
#
# It needs no signing key. A report is the answer to "what has this repository been vouched for",
# which is a question asked most often by somebody who did not write it: continuous integration, or
# a person deciding whether to trust the outputs.

source "${FREEPORTS_VALIDATE_LIB}/utils"

require_sources || exit 1

# Every diagnostic goes to standard error, because standard output is the model and a warning
# printed into it would break every consumer at once. The checks below are therefore run in their
# quiet mode -- what they *found* is in the model; what it *means* is `check-grants`' job.

# ---------------------------------------------------------------------------
# The general methodology, which every document's `version` field is a claim about
# ---------------------------------------------------------------------------

general_state="resolved"
general_uri=""
general_sha=""
general_origin=""

resolution=$(resolve_general_methodology)
case $? in
    0)
        { read -r general_uri; read -r path; read -r general_origin; } <<<"$resolution"
        general_sha=$(sha256_of_file "$path")
        ;;
    "$SOURCE_UNRESOLVED") general_state="unresolved" ;;
    *)                    general_state="unreachable" ;;
esac

# The two words the run as a whole is summed up in. They are accumulated rather than computed at
# the end because the distinction only exists per finding: a claim disproved is a failure, a claim
# that could not be checked is not -- and a run must never go red because a source was unreachable.
failing=false
inconclusive=false

[ "$general_state" = "unresolved" ] && failing=true
[ "$general_state" = "unreachable" ] && inconclusive=true

# ---------------------------------------------------------------------------
# Walking the documents
# ---------------------------------------------------------------------------

contributors=()
grants=()

# Where every list that grows with the repository is built.
#
# Linux caps a *single* argument at 128 KiB (`MAX_ARG_STRLEN`), however much room the whole command
# line has. A repository whose test suite has actually been vouched for holds several hundred
# grants, which is past that limit once each grant is an object -- so `jq -n --argjson grants
# "$(...)"` died with `Argument list too long`, and took the coverage report down with it: the
# renderings are all functions of this model, and the pre-commit hook that refreshes them is
# written never to fail a commit, so the repository quietly kept publishing figures from before.
#
# Everything of that shape therefore travels as a file read with `jq --slurpfile`, which has no
# size limit. The rule to keep: a value whose size is a function of the repository is never an
# argument.
WORKSPACE=$(mktemp -d "${TMPDIR:-/tmp}/freeports-collect.XXXXXX") || exit 1
trap 'rm -rf "$WORKSPACE"' EXIT

#: Joins a methodology name to a path to make one key of an associative array. A unit separator,
#: because the two halves are arbitrary text and this is the one byte neither of them can contain.
US=$'\037'

# Keyed by methodology name, and filled as the documents are read. A methodology is a thing several
# contributors adopt, so it cannot be described from inside the loop over one document.
declare -A method_seen=()
declare -A method_adoptions=()
declare -A method_grants=()
declare -A method_granted=()
method_order=()

granted_files=()

remember_methodology() {
    local name="$1"
    if [ -z "${method_seen[$name]:-}" ]; then
        method_seen[$name]=1
        method_adoptions[$name]=""
        method_grants[$name]=0
        # The granted paths accumulate in a file, one per line, and are made a set once at the end.
        # Keeping them as a JSON string meant a `jq` invocation per granted file over an array one
        # element longer each time -- quadratic in the number of grants, for a `unique` that only
        # has to be true when it is read.
        method_granted[$name]=$(mktemp "$WORKSPACE/granted.XXXXXX")
        method_order+=("$name")
    fi
}

for doc in "$DOCUMENT_DIR"/*.yaml; do
    [ -f "$doc" ] || continue

    who_name=$(yq -r '.who.name // ""' "$doc" 2>/dev/null)
    who_email=$(yq -r '.who.email // ""' "$doc" 2>/dev/null)
    who_key=$(yq -r '.who.pubkey_id // ""' "$doc" 2>/dev/null)
    document_path=$(realpath --relative-to="$REPO_ROOT" "$doc")

    schema="valid"
    validate_document_schema "$doc" >/dev/null 2>&1 || schema="invalid"

    validate_document_signature "$doc" >/dev/null 2>&1
    case $? in
        0) signature="valid" ;;
        2) signature="missing" ;;
        *) signature="invalid" ;;
    esac

    # A version is a claim about a text, so when the text could not be read the claim is neither
    # kept nor broken. `unknown` is that third answer, and it is why an unreachable source does not
    # quietly disqualify every document in the repository from being counted.
    stored_version=$(yq -r '.version // ""' "$doc" 2>/dev/null)
    if [ "$general_state" != "resolved" ]; then
        version="unknown"
    elif [ "$stored_version" = "$general_sha" ]; then
        version="current"
    else
        version="stale"
    fi

    # What "counted" means, and why it is not the same as "valid": coverage is a statement about
    # assurance, and a document that is unsigned or wrongly signed asserts nothing, so its grants
    # cannot raise a percentage. They are still listed -- an uncounted grant that were also
    # invisible would be a report quietly disagreeing with the repository it describes.
    counted=true
    [ "$schema" = "valid" ] || counted=false
    [ "$signature" = "valid" ] || counted=false
    [ "$version" = "stale" ] && counted=false

    [ "$schema" = "invalid" ] && failing=true
    [ "$signature" = "valid" ] || failing=true
    [ "$version" = "stale" ] && failing=true
    [ "$version" = "unknown" ] && inconclusive=true

    adopted=()
    count=$(yq -r '.methodologies | length' "$doc" 2>/dev/null)
    for ((i = 0; i < count; i++)); do
        name=$(yq -r ".methodologies[$i].name // \"\"" "$doc" 2>/dev/null)
        [ -n "$name" ] || continue
        stored=$(yq -r ".methodologies[$i].sha256 // \"\"" "$doc" 2>/dev/null)
        remember_methodology "$name"
        adopted+=("$name")

        # Resolved once per run however many documents adopt it: `load_page_report` caches, which
        # is what keeps a repository with ten contributors from fetching the same page ten times.
        load_page_report "$name"
        resolved_status=$?
        if [ "$resolved_status" -eq 0 ]; then
            current=$(sha256_of_file "$PAGE_PATH")
            if [ "$stored" = "$current" ]; then
                adoption_state="current"
            else
                adoption_state="changed"
                failing=true
            fi
        else
            adoption_state="unknown"
            inconclusive=true
        fi

        adoption=$(jq -nc \
            --arg contributor "$who_name" \
            --arg document "$document_path" \
            --arg sha256 "$stored" \
            --arg state "$adoption_state" \
            '{contributor: $contributor, document: $document, sha256: $sha256, state: $state}')
        method_adoptions[$name]="${method_adoptions[$name]:+${method_adoptions[$name]},}$adoption"
    done

    # Every methodology this document has a `data` section for, whether or not anything is granted
    # under it: an adopted methodology with an empty file list is still one this repository knows
    # about, and dropping it here would make it disappear from the report.
    while IFS= read -r method; do
        [ -n "$method" ] && remember_methodology "$method"
    done < <(yq -r '[.data[]? | .methodology // ""] | .[]' "$doc" 2>/dev/null)

    # Everything the document grants, in one read: methodology, path and recorded hash, one JSON
    # object per line. Asked entry by entry it was two `yq` invocations per granted file over a
    # document that holds a line per grant, and `yq` is itself a Python process wrapping `jq` --
    # a tenth of a second each, several hundred times.
    document_grants="$WORKSPACE/document-grants.json"
    yq -c '[.data[]? | (.methodology // "") as $methodology
           | .files[]?
           | select(.path != null and .path != "")
           | {methodology: $methodology, path: .path, sha256: (.sha256 // "")}]
           | .[] | select(.methodology != "")' \
        "$doc" > "$document_grants" 2>/dev/null || : > "$document_grants"

    mapfile -t doc_methods < <(jq -r '.methodology' "$document_grants")
    mapfile -t doc_paths < <(jq -r '.path' "$document_grants")
    mapfile -t doc_shas < <(jq -r '.sha256' "$document_grants")

    grant_count=${#doc_paths[@]}

    # The hashes of the granted files that are there, in one `sha256sum`. A grant is a claim about
    # file contents, so reading them is work this cannot avoid; starting two processes per file to
    # do it is work it can.
    declare -A actual_hash=()
    present_relative=()
    present_absolute=()
    for file_path in ${doc_paths[@]+"${doc_paths[@]}"}; do
        if [ -f "$REPO_ROOT/$file_path" ]; then
            present_relative+=("$file_path")
            present_absolute+=("$REPO_ROOT/$file_path")
        fi
    done
    if [ "${#present_absolute[@]}" -gt 0 ]; then
        mapfile -t present_hashes < <(sha256sum -- "${present_absolute[@]}" | awk '{print $1}')
        for index in "${!present_relative[@]}"; do
            actual_hash["${present_relative[$index]}"]="${present_hashes[$index]}"
        done
    fi

    # What each methodology declares, asked once per methodology rather than once per file. The
    # answer is a fact about a page and a path, and the page is resolved once for the whole run, so
    # asking per file only ever repeated the same question with a fresh interpreter behind it.
    #
    # `null` and not `false` when the page could not be resolved: the methodology is what says
    # which paths it covers, so an unread page leaves the question unasked rather than answered in
    # the negative.
    declare -A scope_unknown=()
    declare -A out_of_scope=()
    for method in ${method_order[@]+"${method_order[@]}"}; do
        method_paths=()
        for index in ${doc_paths[@]+"${!doc_paths[@]}"}; do
            [ "${doc_methods[$index]}" = "$method" ] && method_paths+=("${doc_paths[$index]}")
        done
        [ "${#method_paths[@]}" -gt 0 ] || continue

        unsupported_paths "$method" "${method_paths[@]}"
        if [ "$?" -eq "$PATH_UNDECIDABLE" ]; then
            scope_unknown["$method"]=1
            continue
        fi
        for file_path in ${UNSUPPORTED_PATHS[@]+"${UNSUPPORTED_PATHS[@]}"}; do
            out_of_scope["$method$US$file_path"]=1
        done
    done

    # The two per-grant findings, as two columns in the order the grants were read. They are joined
    # back onto the objects below in a single `jq`; a `jq` per grant to build one small object was
    # several hundred process starts for a shape that never varies.
    findings="$WORKSPACE/findings.tsv"
    {
        for index in ${doc_paths[@]+"${!doc_paths[@]}"}; do
            file_path="${doc_paths[$index]}"
            method="${doc_methods[$index]}"

            if [ -z "${actual_hash[$file_path]+set}" ]; then
                state="missing"
                failing=true
            elif [ "${actual_hash[$file_path]}" = "${doc_shas[$index]}" ]; then
                state="current"
            else
                state="changed"
                failing=true
            fi

            if [ -n "${scope_unknown[$method]:-}" ]; then
                in_scope="null"
            elif [ -n "${out_of_scope[$method$US$file_path]:-}" ]; then
                in_scope="false"
            else
                in_scope="true"
            fi

            printf '%s\t%s\n' "$state" "$in_scope"

            method_grants[$method]=$((${method_grants[$method]} + 1))
            granted_files+=("$file_path")
            [ "$counted" = true ] && printf '%s\n' "$file_path" >> "${method_granted[$method]}"
        done
    } > "$findings"

    while IFS= read -r grant; do
        grants+=("$grant")
    done < <(jq -c \
        --arg contributor "$who_name" \
        --arg document "$document_path" \
        --rawfile findings "$findings" \
        --slurpfile entries "$document_grants" \
        -n '
        (if ($findings | length) == 0 then []
         else ($findings | rtrimstr("\n") | split("\n") | map(split("\t"))) end) as $found
        | $entries
        | to_entries[]
        | {path: .value.path, sha256: .value.sha256, methodology: .value.methodology,
           contributor: $contributor, document: $document,
           state: $found[.key][0], in_scope: ($found[.key][1] | fromjson)}')

    contributors+=("$(jq -nc \
        --arg name "$who_name" \
        --arg email "$who_email" \
        --arg pubkey_id "$who_key" \
        --arg document "$document_path" \
        --arg schema "$schema" \
        --arg signature "$signature" \
        --arg version "$version" \
        --argjson counted "$counted" \
        --argjson grants "$grant_count" \
        --args '{name: $name, email: $email, pubkey_id: $pubkey_id, document: $document,
                 schema: $schema, signature: $signature, version: $version,
                 counted: $counted, grants: $grants, methodologies: $ARGS.positional}' \
        "${adopted[@]}")")
done

# ---------------------------------------------------------------------------
# What each methodology declares, and what it could therefore be complete against
# ---------------------------------------------------------------------------
#
# The denominator is the set of files in the working tree the methodology's own patterns match --
# what it *could* cover -- and the numerator is how many of those somebody has actually vouched
# for. A methodology that declares no paths has no denominator at all: there is nothing it could be
# complete against, and inventing one would put a meaningless percentage on a badge.

methodologies=()
all_candidates_file="$WORKSPACE/all-candidates"
all_covered_file="$WORKSPACE/all-covered"
: > "$all_candidates_file"
: > "$all_covered_file"

for name in "${method_order[@]}"; do
    load_page_report "$name"
    case $? in
        0)                    state="resolved" ;;
        "$SOURCE_UNRESOLVED") state="unresolved"; failing=true ;;
        *)                    state="unreachable"; inconclusive=true ;;
    esac

    uri="null"
    sha="null"
    origin="null"
    declares="null"
    patterns="[]"
    coverage="null"

    if [ "$state" = "resolved" ]; then
        uri=$(jq -nc --arg value "$PAGE_URI" '$value')
        sha=$(jq -nc --arg value "$(sha256_of_file "$PAGE_PATH")" '$value')
        origin=$(jq -nc --arg value "$PAGE_ORIGIN" '$value')
        declares=$(echo "$PAGE_REPORT_JSON" | jq -c '.supported_paths.declared')
        patterns=$(echo "$PAGE_REPORT_JSON" | jq -c '.supported_paths.patterns')

        if [ "$declares" = "true" ]; then
            # The denominator and the numerator are both sets of repository paths, so both are of a
            # size that grows with the repository: they are built in files for the same reason the
            # model is assembled from files.
            candidates_file="$WORKSPACE/candidates"
            : > "$candidates_file"
            while IFS= read -r pattern; do
                [ -n "$pattern" ] || continue
                python3 "${LIB_DIR}/pathmatch.py" expand "$pattern" "$REPO_ROOT" \
                    | jq -r '.[]' >> "$candidates_file"
            done < <(echo "$patterns" | jq -r '.[].pattern')

            sort -u "$candidates_file" | jq -Rn '[inputs]' > "$WORKSPACE/candidates.json"
            sort -u "${method_granted[$name]}" | jq -Rn '[inputs]' > "$WORKSPACE/granted.json"

            # Intersection, written as jq writes it: everything in the candidate set that is not
            # outside the granted set. Only files the methodology declares count towards it, so a
            # forced grant of something out of scope raises no percentage.
            jq -nc --slurpfile c "$WORKSPACE/candidates.json" --slurpfile g "$WORKSPACE/granted.json" \
                '$c[0] - ($c[0] - $g[0])' > "$WORKSPACE/covered.json"

            coverage=$(jq -nc --slurpfile c "$WORKSPACE/candidates.json" \
                --slurpfile g "$WORKSPACE/covered.json" \
                '{candidates: ($c[0] | length), granted: ($g[0] | length),
                  ratio: (if ($c[0] | length) == 0 then null
                          else (($g[0] | length) / ($c[0] | length)) end)}')

            jq -r '.[]' "$WORKSPACE/candidates.json" >> "$all_candidates_file"
            jq -r '.[]' "$WORKSPACE/covered.json" >> "$all_covered_file"
        fi
    fi

    methodologies+=("$(jq -nc \
        --arg name "$name" \
        --arg state "$state" \
        --argjson uri "$uri" \
        --argjson sha256 "$sha" \
        --argjson origin "$origin" \
        --argjson declares_paths "$declares" \
        --argjson patterns "$patterns" \
        --argjson adoptions "[${method_adoptions[$name]}]" \
        --argjson grants "${method_grants[$name]}" \
        --argjson coverage "$coverage" \
        '{name: $name, state: $state, uri: $uri, sha256: $sha256, origin: $origin,
          declares_paths: $declares_paths, patterns: $patterns, adoptions: $adoptions,
          grants: $grants, coverage: $coverage}')")
done

# ---------------------------------------------------------------------------
# The model
# ---------------------------------------------------------------------------

status="passing"
[ "$inconclusive" = true ] && status="inconclusive"
[ "$failing" = true ] && status="failing"

# Two arrays, because the two things being gathered are not the same kind of thing: one is a stream
# of JSON objects already built by `jq -nc`, the other is a list of plain paths that still have to
# be quoted as strings. Feeding the second to the first would be a parse error on any repository
# that had a grant in it.
#
# Both write a *file*, and both guard the empty case explicitly -- `printf '%s\n' "${array[@]}"`
# over an empty array prints one blank line rather than nothing, which jq reads as an empty string
# rather than as no elements. A file rather than standard output because these are the values that
# grow with the repository, and the whole point is that they never become arguments: `printf` is a
# shell builtin, so the array reaches it without passing through the kernel's argument limits at
# all.
as_json_array() {
    local destination="$1"
    shift
    if [ "$#" -eq 0 ]; then
        echo "[]" > "$destination"
    else
        printf '%s\n' "$@" | jq -sc '.' > "$destination"
    fi
}

as_string_array() {
    local destination="$1"
    shift
    if [ "$#" -eq 0 ]; then
        echo "[]" > "$destination"
    else
        printf '%s\n' "$@" | jq -Rsc 'split("\n")[:-1]' > "$destination"
    fi
}

as_json_array "$WORKSPACE/contributors.json" ${contributors[@]+"${contributors[@]}"}
as_json_array "$WORKSPACE/methodologies.json" ${methodologies[@]+"${methodologies[@]}"}
as_json_array "$WORKSPACE/grants.json" ${grants[@]+"${grants[@]}"}
as_string_array "$WORKSPACE/granted-files.json" ${granted_files[@]+"${granted_files[@]}"}

sort -u "$all_candidates_file" | jq -Rn '[inputs]' > "$WORKSPACE/all-candidates.json"
sort -u "$all_covered_file" | jq -Rn '[inputs]' > "$WORKSPACE/all-covered.json"

distinct_files=$(jq -c 'unique | length' "$WORKSPACE/granted-files.json")

jq -n \
    --arg root "$REPO_ROOT" \
    --arg name "$(basename "$REPO_ROOT")" \
    --argjson sources "$(printf '%s\n' "${VALIDATE_SOURCES[@]}" | jq -Rsc 'split("\n")[:-1]')" \
    --argjson general "$(jq -nc \
        --arg state "$general_state" \
        --arg uri "$general_uri" \
        --arg sha256 "$general_sha" \
        --arg origin "$general_origin" \
        '{state: $state,
          uri: (if $uri == "" then null else $uri end),
          sha256: (if $sha256 == "" then null else $sha256 end),
          origin: (if $origin == "" then null else $origin end)}')" \
    --slurpfile contributors "$WORKSPACE/contributors.json" \
    --slurpfile methodologies "$WORKSPACE/methodologies.json" \
    --slurpfile grants "$WORKSPACE/grants.json" \
    --slurpfile candidates "$WORKSPACE/all-candidates.json" \
    --slurpfile covered "$WORKSPACE/all-covered.json" \
    --argjson files "$distinct_files" \
    --arg status "$status" \
    '$contributors[0] as $who
     | $methodologies[0] as $methods
     | $grants[0] as $vouched
     | $candidates[0] as $could
     | $covered[0] as $did
     | {repository: {root: $root, name: $name},
      sources: $sources,
      general_methodology: $general,
      contributors: $who,
      methodologies: $methods,
      grants: $vouched,
      coverage: {candidates: ($could | length),
                 granted: ($did | length),
                 ratio: (if ($could | length) == 0 then null
                         else (($did | length) / ($could | length)) end)},
      totals: {contributors: ($who | length),
               methodologies: ($methods | length),
               grants: ($vouched | length),
               files: $files},
      status: $status}'
