#!/bin/bash

source "${FREEPORTS_VALIDATE_LIB}/utils"

# Main execution
if [ $# -eq 0 ]; then
    overall_errors=0

    if [ -n "$PERSONAL_DOC" ]; then
        # A key was named, so there is a document that is *yours*, and that is the one meant by
        # asking without arguments.
        print_info "Checking personal validation document..."
        echo ""

        if [ -f "$PERSONAL_DOC" ]; then
            validate_document_comprehensive "$PERSONAL_DOC"
            overall_errors=$((overall_errors + $?))
            echo ""
        else
            print_warning "No personal validation document found at: $PERSONAL_DOC"
            echo "Run 'create-document' to create your validation document"
        fi
    else
        # No key: nothing here is "yours", so the question can only be about the repository as a
        # whole -- which is the question continuous integration and anyone auditing somebody else's
        # repository were asking in the first place.
        print_info "No signing key configured: checking every validation document in the repository..."
        echo ""

        found=false
        for doc in "$DOCUMENT_DIR"/*.yaml; do
            [ -f "$doc" ] || continue
            found=true
            validate_document_comprehensive "$doc"
            overall_errors=$((overall_errors + $?))
            echo ""
        done

        if [ "$found" = false ]; then
            print_warning "No validation documents found in: $DOCUMENT_DIR"
        fi
    fi

    # Once, for the whole run: the same stale methodology page fails in every contributor's
    # document, and the reader needs to be told what that means one time, not once each.
    #
    # Printed whether or not the run failed, because not every diagnosis is a failure. A methodology
    # that could not be reached is a warning, and a warning nobody explains is a warning nobody acts
    # on -- which is precisely the state this run is in when it exits zero with a page unexamined.
    if [ $overall_errors -eq 0 ]; then
        print_success "All validation documents passed verification"
        print_diagnoses
        exit 0
    else
        print_error "Some validation documents have errors"
        print_diagnoses
        exit 1
    fi
else
    # Check specific document
    doc_path="$1"
    if [[ "$doc_path" != /* ]]; then
        doc_path="$DOCUMENT_DIR/$doc_path"
    fi

    if [ ! -f "$doc_path" ]; then
        print_error "Document '$doc_path' does not exist"
        exit 1
    fi

    validate_document_comprehensive "$doc_path"
    status=$?
    print_diagnoses
    exit $status
fi
