#!/bin/bash
source "${FREEPORTS_VALIDATE_LIB}/utils"

VERSION=$(get_version_methodology)
if [ -f "${PERSONAL_DOC}" ]; then
    print_error "File \"${PERSONAL_DOC}\" already present, refuse to overwrite"
    echo "Delete the file before creating a new one"
    exit 1
fi

concrete_yaml(){
    yq \
    ".version=\"${VERSION}\" | .who.name=\"${NAME}\" | .who.email=\"${EMAIL}\" | .who.pubkey_id=\"${KEYID}\"" \
    "${LIB_DIR}/document.template.yaml" -y
}

print_info "Creating validation document: $(basename "$PERSONAL_DOC")"

# Create document with schema validation
if (concrete_yaml | check-jsonschema --schemafile "${LIB_DIR}/document.schema.json" --default-filetype yaml - 1> /dev/null); then
    concrete_yaml > "${PERSONAL_DOC}"
    print_success "Validation document created successfully: $PERSONAL_DOC"
    echo "Remember to sign the document with 'sign-document' to make it valid"
else
    print_error "Failed to create valid validation document"
    exit 1
fi
