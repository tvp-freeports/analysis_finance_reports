#!/bin/bash

# Everything a script needs is decided by `cli.py` before it hands over, and arrives here already
# resolved: the command line, the environment and the configuration file have been merged there, in
# the one place that knows how. The two fallbacks below are the tool's own defaults, reached only
# when nothing named a value at all.

if [ -z "$FREEPORTS_VALIDATE_KEY_ID" ]; then
    echo "Specify the public key that identifies you as the signer."
    echo "Give it as --key-id, as FREEPORTS_VALIDATE_KEY_ID, or as validate.key_id in the"
    echo "freeports configuration file."
    exit 1
fi
export KEYID="$FREEPORTS_VALIDATE_KEY_ID"

if [ -n "$FREEPORTS_FORMATS_REPO_PATH" ]; then
    export REPO_ROOT="$FREEPORTS_FORMATS_REPO_PATH"
else
    # This command's own default, and deliberately reaching further than the working directory the
    # other two fall back to: a validation document lives at the repository root, while grants are
    # issued from wherever in the tree the granted file happens to be. Outside a Git checkout there
    # is nothing to walk up to, so the working directory is the last resort -- which is what the
    # other two commands would have done in the first place.
    export REPO_ROOT=$(git rev-parse --show-toplevel 2>/dev/null || pwd)
fi

export LIB_DIR="${FREEPORTS_VALIDATE_LIB}"
export BIN_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && cd ../bin && pwd)"
export METHODOLOGY_DIR="${FREEPORTS_VALIDATE_DOCS}/validation"
export ASSERT_DIR="${METHODOLOGY_DIR}/assertions"
export TEST_DIR="${REPO_ROOT}/tests"
export DOCUMENT_DIR="${REPO_ROOT}/validation"

source "${LIB_DIR}/validation_utils.sh"
source "${LIB_DIR}/document_utils.sh"

# Get UID information and parse it
user_id=$(gpg --list-keys --with-colons "$KEYID" 2>/dev/null | grep "^uid:" | head -n 1 | cut -d: -f10)
if [ -z "$user_id" ]; then
    echo "Error: Key '$KEYID' not found or has no UID"
    exit 1
fi

# Extract name and email
export NAME=$(echo "$user_id" | sed 's/ <.*//' | sed 's/ *(.*)//')
export EMAIL=$(echo "$user_id" | grep -o '<[^>]*>' | head -n 1 | sed 's/[<>]//g')
out_file_name=$(echo "$NAME" | tr ' ' '_' | tr '[:upper:]' '[:lower:]')
export PERSONAL_DOC="${DOCUMENT_DIR}/${out_file_name}.yaml"

get_version_methodology(){
    sha256sum "$METHODOLOGY_DIR/general_methodology.rst" | awk '{print $1}'
}
