#!/bin/sh
#
# Pre-commit hook. Active because `core.hooksPath` points at `.githooks/`, which `make githooks`
# sets up.
#
# Three gates, cheapest first:
#   1. the `freeports-dev` environment must be active (the tests that cross into PyMuPDF need it);
#   2. no non-ASCII filenames may be added;
#   3. `make pre-commit` — clippy, ruff, and the crate's full suite.
#
# The third gate is a *name*, not a list: what the commit gate consists of is decided in the
# Makefile at the repository root, so it can grow without this file being touched. Today it is
# lint plus the full test suite.
#
# Between the second and the third sits something that is not a gate at all: the validation report
# is refreshed and staged, and the grants are checked. Neither can refuse a commit — see the
# section itself for why.
#
# Note that it sees the *working tree*, not the staged snapshot: a commit of a subset of your
# changes is checked against everything you have on disk.

if [ "$(basename "${VIRTUAL_ENV:-}")" != "freeports-dev" ] && [ "${CONDA_DEFAULT_ENV:-}" != "freeports-dev" ]; then
    echo "You have to activate \`freeports-dev\` environment to commit" 1>&2
    echo "In order to do so, execute one of the following:" 1>&2
    echo "  - venv  →  source venv/freeports-dev/bin/activate" 1>&2
    echo "            (Windows: source venv/freeports-dev/Scripts/activate)" 1>&2
    echo "  - conda →  conda activate freeports-dev" 1>&2
    exit 1
fi

if git rev-parse --verify HEAD >/dev/null 2>&1
then
	against=HEAD
else
	# Initial commit: diff against an empty tree object
	against=$(git hash-object -t tree /dev/null)
fi

# If you want to allow non-ASCII filenames set this variable to true.
allownonascii=$(git config --type=bool hooks.allownonascii)

# Cross platform projects tend to avoid non-ASCII filenames; prevent
# them from being added to the repository. We exploit the fact that the
# printable range starts at the space character and ends with tilde.
if [ "$allownonascii" != "true" ] &&
	# Note that the use of brackets around a tr range is ok here, (it's
	# even required, for portability to Solaris 10's /usr/bin/tr), since
	# the square bracket bytes happen to fall in the designated range.
	test $(git diff-index --cached --name-only --diff-filter=A -z $against |
	  LC_ALL=C tr -d '[ -~]\0' | wc -c) != 0
then
	cat <<\MSG 1>&2
Error: Attempt to add a non-ASCII file name.

This can cause problems if you want to work with people on other platforms.

To be portable it is advisable to rename the file.

If you know what you are doing you can disable this check using:

  git config hooks.allownonascii true
MSG
	exit 1
fi

# The repository being committed, named outright rather than inherited.
#
# Everything below acts on *this* working tree, and git already knows which one it is. Left to
# resolve it themselves, the commands would each consult their own tiers — `--repo`, then
# `FREEPORTS_FORMATS_REPO_PATH`, then `formats_repo` in whatever configuration file is found from
# here — and any of those can name a different repository than the one you are committing to.
repo_root=$(git rev-parse --show-toplevel) || exit 1


# Keep the validation report current, and never refuse a commit over it.
#
# The three badges in README.md, the summary block in it, the seven pages under
# `docs/source/validation/report/` and the coverage page generated into `docs/source/_extra/` are
# all functions of what `validation/` claims. A commit that changes a granted assertion and leaves
# them alone publishes figures that are already wrong, so they are regenerated here and what was
# rewritten is added to the commit being made.
#
# What this consists of is decided in the Makefile, like the gate at the bottom of this file:
# `make validation-report` is one walk of the repository rendered ten times, and it is also the
# command to run by hand. The list of files to stage is here rather than there because staging is
# git's business and the Makefile has none.
#
# Nothing in this section can fail the hook, on purpose. The figures depend on fetching every
# methodology page from the configured sources, and a committer on a train, behind a proxy, or
# working while the documentation server is down still has to be able to commit. A report one run
# out of date is a smaller problem than a commit that cannot be made.
if command -v freeports-validate >/dev/null 2>&1; then
    if make -C "$repo_root" -s validation-report >/dev/null 2>&1; then
        # `docs/source/_extra/` is gitignored — it is a product of the documentation build, not a
        # file in the tree — so it is refreshed above and deliberately not staged here.
        refreshed="README.md validation/report/badges"
        for page in index file-contributor file-methodology contributor-methodology \
                    contributor-file methodology-file methodology-contributor; do
            refreshed="$refreshed docs/source/validation/report/$page.rst"
        done

        # Unquoted on purpose: the names are the fixed ones just above, none of which contains a
        # space, and this is the one place the list has to be split back into arguments.
        git -C "$repo_root" add -- $refreshed
        echo "freeports-validate: report refreshed"
    else
        echo "freeports-validate: the grants could not be read, so the report is unchanged" 1>&2
    fi

    # The integrity check itself, and it warns rather than refuses.
    #
    # It is loud when it has something to say, and what it has to say is never nothing: a page that
    # could not be fetched exits non-zero here too, because a grant nobody could verify is a grant
    # this run does not vouch for — see `freeports-validate check-grants`, which distinguishes the
    # two cases in its own output. Neither stops the commit: deciding what a broken or unverified
    # grant means is the granter's, and the badge, the report and this message all record it.
    if ! make -C "$repo_root" -s check-grants; then
        echo 1>&2
        echo "freeports-validate: the grants above are not all vouched for by this run." 1>&2
        echo "The commit is not being refused. Re-grant with \`freeports-validate grant\`, or" 1>&2
        echo "restate a changed one with \`freeports-validate update\`, once you know which it is." 1>&2
    fi
fi


# Last, because it is the slow one. The `|| exit 1` is not decoration: without it a failing gate
# only prints its errors and the commit goes through anyway.
make pre-commit || {
	echo 1>&2
	echo "Commit gate failed — commit refused. Run \`make pre-commit\` to see it again," 1>&2
	echo "or commit with --no-verify if you know what you are doing." 1>&2
	exit 1
}
