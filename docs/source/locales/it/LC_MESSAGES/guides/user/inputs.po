msgid "how to read the layouts you care about"
msgstr "come leggere le impaginazioni che ti interessano"

#: ../../source/guides/user/inputs.md
msgid "`--formats-directory` / `--repo` / `-F` / `-r`, or `FREEPORTS_FORMATS_REPO_PATH`"
msgstr "`--formats-directory` / `--repo` / `-F` / `-r`, oppure `FREEPORTS_FORMATS_REPO_PATH`"

#: ../../source/guides/user/inputs.md
#, python-brace-format
msgid "{doc}`../formats/repository`"
msgstr "{doc}`../formats/repository`"

#: ../../source/guides/user/inputs.md
msgid "**input database**"
msgstr "**database di ingresso**"

#: ../../source/guides/user/inputs.md
msgid "which companies to look for, and how to recognise each"
msgstr "quali società cercare, e come riconoscere ciascuna"

#: ../../source/guides/user/inputs.md
msgid "`--db-directory` / `-I`, plus `--target-list` / `-T`"
msgstr "`--db-directory` / `-I`, più `--target-list` / `-T`"

