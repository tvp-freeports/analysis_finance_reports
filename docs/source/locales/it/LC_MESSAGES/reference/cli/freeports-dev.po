msgstr "come sopra"

#: ../../source/reference/cli/freeports-dev.md
msgid "`--noconfirm`"
msgstr "`--noconfirm`"

#: ../../source/reference/cli/freeports-dev.md
msgid "do not ask before writing each fixture. Also `dev.noconfirm`"
msgstr "non chiedere prima di scrivere ciascuna fixture. Anche `dev.noconfirm`"

#: ../../source/reference/cli/freeports-dev.md
msgid "`--skip-pdf-blks`, `--skip-txt-blks`, `--skip-results`"
msgstr "`--skip-pdf-blks`, `--skip-txt-blks`, `--skip-results`"

