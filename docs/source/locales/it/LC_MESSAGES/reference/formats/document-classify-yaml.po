msgstr "Errori di forma"

#: ../../source/reference/formats/document-classify-yaml.md
msgid "Message"
msgstr "Messaggio"

#: ../../source/reference/formats/document-classify-yaml.md
msgid "Caused by"
msgstr "Causato da"

