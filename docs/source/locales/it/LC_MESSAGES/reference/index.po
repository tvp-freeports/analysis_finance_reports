#, python-brace-format
msgid "{doc}`cli/index`"
msgstr "{doc}`cli/index`"

#: ../../source/reference/index.md:10
msgid "every option of `freeports`, `freeports-dev` and `freeports-validate`"
msgstr "ogni opzione di `freeports`, `freeports-dev` e `freeports-validate`"

#: ../../source/reference/index.md:10
#, python-brace-format
msgid "{doc}`configuration/index`"
msgstr "{doc}`configuration/index`"

#: ../../source/reference/index.md:10
msgid "the four places a setting can come from, and how they merge"
msgstr "i quattro posti da cui può venire un'impostazione, e come si fondono"

#: ../../source/reference/index.md:10
#, python-brace-format
msgid "{doc}`design/index`"
msgstr "{doc}`design/index`"

#: ../../source/reference/index.md:10
msgid ""
"the algorithm, chapter by chapter, with each claim marked implemented, planned or "
"accepted limit"
msgstr ""
"l'algoritmo, capitolo per capitolo, con ogni affermazione marcata come realizzata, "
"prevista o limite accettato"

