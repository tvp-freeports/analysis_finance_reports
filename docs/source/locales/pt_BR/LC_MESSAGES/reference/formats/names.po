msgstr "entidade"

#: ../../source/reference/formats/names.md:16
msgid "any characters except `-`, `@`, `.`, `*` and spaces"
msgstr "qualquer caractere exceto `-`, `@`, `.`, `*` e espaços"

#: ../../source/reference/formats/names.md:16
msgid ""
"the name the document is identified by — in practice the group behind the"
" funds, as named at the start of the document"
msgstr ""
"o nome pelo qual o documento se identifica — na prática o grupo por trás "
"dos fundos, como aparece no início do documento"

#: ../../source/reference/formats/names.md:16
msgid "`MEDIOLANUM`, `ANIMA_SGR`"
msgstr "`MEDIOLANUM`, `ANIMA_SGR`"

#: ../../source/reference/formats/names.md:16
msgid "language"
msgstr "idioma"

#: ../../source/reference/formats/names.md:16
msgid "two capital letters"
msgstr "duas letras maiúsculas"

#: ../../source/reference/formats/names.md:16
msgid "the language the document is written in"
msgstr "o idioma em que o documento está escrito"

#: ../../source/reference/formats/names.md:16
msgid "`EN`, `IT`, `ES`"
msgstr "`EN`, `IT`, `ES`"

#: ../../source/reference/formats/names.md:16
msgid "year"
msgstr "ano"

#: ../../source/reference/formats/names.md:16
msgid "two digits"
msgstr "dois dígitos"

#: ../../source/reference/formats/names.md:16
msgid "the year of publication"
msgstr "o ano de publicação"

#: ../../source/reference/formats/names.md:16
