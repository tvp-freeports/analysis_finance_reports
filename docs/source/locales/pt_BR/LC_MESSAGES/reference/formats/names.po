msgid "Segment"
msgstr "Segmento"

#: ../../source/reference/formats/names.md:16
msgid "Written"
msgstr "Escrito como"

#: ../../source/reference/formats/names.md:16
msgid "Means"
msgstr "Significa"

#: ../../source/reference/formats/names.md:16
