msgstr "``.json``"

#: ../../source/validation/general_methodology.rst:34
#: ../../source/validation/general_methodology.rst:42
msgid "``.png``"
msgstr "``.png``"

#: ../../source/validation/general_methodology.rst:35
msgid "``.pdf``"
