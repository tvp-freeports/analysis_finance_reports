msgid "`report.pdf`"
msgstr ""

#: ../../source/guides/user/documents.md
msgid "—"
msgstr ""

#: ../../source/guides/user/documents.md
msgid "that path, made absolute"
msgstr ""

#: ../../source/guides/user/documents.md
msgid "its own text"
msgstr ""

#: ../../source/guides/user/documents.md
msgid "`https://…/r.pdf`"
msgstr ""

#: ../../source/guides/user/documents.md
msgid "that URL"
msgstr ""

#: ../../source/guides/user/documents.md
msgid "the URL"
msgstr ""

#: ../../source/guides/user/documents.md
